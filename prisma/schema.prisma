generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ----------------------------------------------------------------------------
// USERS, ROLES, PERMISSIONS
// ----------------------------------------------------------------------------
model User {
  id             String    @id @default(uuid())
  email          String    @unique
  passwordHash   String
  firstName      String?
  lastName       String?
  phone          String?
  isActive       Boolean   @default(true)
  roleId         String?
  role           Role?     @relation(fields: [roleId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  addresses      CustomerAddress[]
  orders         Order[]
  reviews        Review[]
  wishlist       Wishlist[]
  auditLogs      AuditLog[]
  carts          Cart[]
  abandonedCarts AbandonedCart[]
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique // e.g. "Super Admin", "Admin", "Product Manager", "Customer"
  description String?
  users       User[]
  permissions Permission[]
}

model Permission {
  id          String   @id @default(uuid())
  action      String   // e.g. "create:product"
  resource    String   // e.g. "products"
  roleId      String
  role        Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
}

// ----------------------------------------------------------------------------
// CATALOG (Categories, Brands, Products, Variants)
// ----------------------------------------------------------------------------
model Category {
  id          String     @id @default(uuid())
  name        String
  slug        String     @unique
  description String?    @db.Text
  imageUrl    String?    // Added for category cover image
  parentId    String?
  parent      Category?  @relation("SubCategories", fields: [parentId], references: [id])
  children    Category[] @relation("SubCategories")
  active      Boolean    @default(true)
  seoTitle    String?
  seoDesc     String?    @db.Text
  
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Brand {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  description String?   @db.Text
  logoUrl     String?
  products    Product[]
}

model Product {
  id               String   @id @default(uuid())
  name             String
  slug             String   @unique
  sku              String   @unique
  barcode          String?
  shortDescription String?  @db.Text
  longDescription  String?  @db.Text
  
  // Pricing
  price            Decimal  @db.Decimal(10, 2)
  discountPrice    Decimal? @db.Decimal(10, 2)
  taxRate          Decimal  @default(18.00) @db.Decimal(5, 2)
  
  // Inventory (Base)
  stock            Int      @default(0)
  minStockLevel    Int      @default(5)
  
  // Food Commerce Specific
  unit             String?  // e.g. "kg", "g", "adet"
  weight           Decimal? @db.Decimal(10, 2)
  ingredients      String?  @db.Text
  allergens        String?  @db.Text
  origin           String?
  manufacturer     String?
  nutritionalInfo  String?  @db.Text
  storageCond      String?  @db.Text

  // Status & Flags
  isActive         Boolean  @default(false) // Draft by default
  isFeatured       Boolean  @default(false)
  isNew            Boolean  @default(false)
  
  // SEO
  seoTitle         String?
  seoDescription   String?  @db.Text
  canonicalUrl     String?
  isIndexable      Boolean  @default(true)

  // Relations
  categoryId       String?
  category         Category? @relation(fields: [categoryId], references: [id])
  brandId          String?
  brand            Brand?    @relation(fields: [brandId], references: [id])
  
  variants         ProductVariant[]
  images           ProductImage[]
  attributes       ProductAttribute[]
  inventory        Inventory[]
  reviews          Review[]
  orderItems       OrderItem[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model ProductVariant {
  id            String   @id @default(uuid())
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  sku           String   @unique
  name          String   // e.g. "250g", "Kavrulmuş"
  price         Decimal? @db.Decimal(10, 2) // Override product price
  discountPrice Decimal? @db.Decimal(10, 2)
  stock         Int      @default(0)
  weight        Decimal? @db.Decimal(10, 2)
  
  orderItems    OrderItem[]
  cartItems     CartItem[]
}

model ProductImage {
  id         String   @id @default(uuid())
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  url        String
  altText    String?
  isMain     Boolean  @default(false)
  sortOrder  Int      @default(0)
  sourceUrl  String?  // If fetched from API
  creator    String?  // Licensing info
}

model ProductAttribute {
  id        String  @id @default(uuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String  // e.g. "Tuz Oranı"
  value     String  // e.g. "Tuzsuz"
}

// ----------------------------------------------------------------------------
// INVENTORY
// ----------------------------------------------------------------------------
model Inventory {
  id           String             @id @default(uuid())
  productId    String
  product      Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity     Int
  movements    InventoryMovement[]
}

model InventoryMovement {
  id          String    @id @default(uuid())
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  type        String    // "IN", "OUT", "ADJUSTMENT"
  quantity    Int
  reason      String?
  createdAt   DateTime  @default(now())
}

// ----------------------------------------------------------------------------
// CUSTOMERS & ADDRESSES
// ----------------------------------------------------------------------------
model CustomerAddress {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String   // e.g. "Ev", "İş"
  fullName   String
  phone      String
  city       String
  district   String
  address    String   @db.Text
  zipCode    String?
  isDefault  Boolean  @default(false)
  
  orders     Order[]
}

// ----------------------------------------------------------------------------
// ORDERS & PAYMENTS
// ----------------------------------------------------------------------------
model Order {
  id                String          @id @default(uuid())
  orderNumber       String          @unique
  userId            String?
  user              User?           @relation(fields: [userId], references: [id])
  addressId         String?
  address           CustomerAddress? @relation(fields: [addressId], references: [id])
  
  // Snapshots (Order Totals)
  subTotal          Decimal         @db.Decimal(10, 2)
  shippingCost      Decimal         @db.Decimal(10, 2)
  taxTotal          Decimal         @db.Decimal(10, 2)
  discountTotal     Decimal         @db.Decimal(10, 2)
  grandTotal        Decimal         @db.Decimal(10, 2)
  
  status            String          // "PENDING", "PROCESSING", "SHIPPED", "DELIVERED", "CANCELLED", "REFUNDED"
  paymentStatus     String          // "PENDING", "PAID", "FAILED"
  paymentMethod     String          // "IYZICO_CARD", "TRANSFER"
  
  notes             String?         @db.Text
  
  items             OrderItem[]
  payments          Payment[]
  refunds           Refund[]

  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
}

model OrderItem {
  id              String          @id @default(uuid())
  orderId         String
  order           Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  // Relations (can be null if product is deleted later)
  productId       String?
  product         Product?        @relation(fields: [productId], references: [id], onDelete: SetNull)
  variantId       String?
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  
  // Snapshots
  productName     String
  sku             String
  quantity        Int
  unitPrice       Decimal         @db.Decimal(10, 2) // At time of purchase
  taxRate         Decimal         @db.Decimal(5, 2)
  discountAmount  Decimal         @default(0) @db.Decimal(10, 2)
  totalPrice      Decimal         @db.Decimal(10, 2)
}

model Payment {
  id               String   @id @default(uuid())
  orderId          String
  order            Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider         String   // e.g. "IYZICO"
  transactionId    String?  // ID from provider
  conversationId   String?  // Used for idempotency
  amount           Decimal  @db.Decimal(10, 2)
  status           String   // "SUCCESS", "FAILED", "PENDING"
  rawResponse      String?  @db.Text // JSON snapshot from provider
  createdAt        DateTime @default(now())
}

model Refund {
  id            String   @id @default(uuid())
  orderId       String
  order         Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount        Decimal  @db.Decimal(10, 2)
  reason        String?  @db.Text
  status        String   // "PENDING", "APPROVED", "COMPLETED", "REJECTED"
  createdAt     DateTime @default(now())
}

// ----------------------------------------------------------------------------
// MARKETING (Coupons, Campaigns)
// ----------------------------------------------------------------------------
model Coupon {
  id               String    @id @default(uuid())
  code             String    @unique
  type             String    // "PERCENTAGE", "FIXED", "FREE_SHIPPING"
  value            Decimal   @db.Decimal(10, 2)
  minCartAmount    Decimal?  @db.Decimal(10, 2)
  usageLimit       Int?
  usedCount        Int       @default(0)
  perCustomerLimit Int?
  startDate        DateTime?
  endDate          DateTime?
  isActive         Boolean   @default(true)
}

model Campaign {
  id          String   @id @default(uuid())
  name        String
  description String?  @db.Text
  type        String   // "BUY_X_GET_Y", "DISCOUNT"
  isActive    Boolean  @default(true)
  startDate   DateTime?
  endDate     DateTime?
}

// ----------------------------------------------------------------------------
// CARTS & WISHLIST
// ----------------------------------------------------------------------------
model Cart {
  id        String     @id @default(uuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionId String?    @unique // for guest carts
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String          @id @default(uuid())
  cartId    String
  cart      Cart            @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variantId String
  variant   ProductVariant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  quantity  Int
}

model AbandonedCart {
  id          String   @id @default(uuid())
  userId      String?
  user        User?    @relation(fields: [userId], references: [id])
  email       String?
  cartData    String   @db.Text // JSON snapshot
  isRecovered Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  createdAt DateTime @default(now())
  
  @@unique([userId, productId])
}

// ----------------------------------------------------------------------------
// OTHERS (Reviews, Settings, AuditLogs, SEO, Media)
// ----------------------------------------------------------------------------
model Review {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rating    Int      // 1-5
  comment   String?  @db.Text
  isApproved Boolean @default(false)
  createdAt DateTime @default(now())
}

model Settings {
  id    String @id @default(uuid())
  key   String @unique
  value String @db.Text
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  resource  String
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())
}

model Redirect {
  id         String   @id @default(uuid())
  sourceUrl  String   @unique
  targetUrl  String
  statusCode Int      @default(301)
}

model MediaLibrary {
  id          String   @id @default(uuid())
  fileName    String
  fileUrl     String
  mimeType    String
  size        Int
  altText     String?
  uploadedBy  String?
  createdAt   DateTime @default(now())
}

model AiGenerationLog {
  id          String   @id @default(uuid())
  prompt      String   @db.Text
  response    String   @db.Text
  type        String   // "PRODUCT_DRAFT", "SEO_TAGS"
  status      String   // "SUCCESS", "FAILED"
  createdAt   DateTime @default(now())
}
